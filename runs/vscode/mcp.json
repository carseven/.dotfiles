{
  "inputs": [],
  "servers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--userDataDir",
        "${env:HOME}/Library/Application Support/BraveSoftware/Brave-Browser",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
